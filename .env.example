# Copy to .env (git-ignored) and fill in real values.
# Docker Compose passes this file to the backend container; ASP.NET Core maps
# the double underscore to a config section (JwtSettings__Secret -> JwtSettings:Secret).

# Neon PostgreSQL connection string
ConnectionStrings__DefaultConnection=Host=...;Database=...;Username=...;Password=...;SSL Mode=Require

# JWT signing key. Generate one with: openssl rand -base64 48
# Changing it invalidates every issued token, so all users must sign in again.
JwtSettings__Secret=
